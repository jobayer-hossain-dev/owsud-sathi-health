# MySQL (cPanel phpMyAdmin)
DB_HOST=localhost
DB_USER=your_cpanel_user
DB_PASSWORD=your_db_password
DB_NAME=oshudhsathi_db
DB_PORT=3306

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=30d

# SMS OTP (BulkSMSBD)
SMS_API_KEY=your_bulksmsbd_api_key
SMS_SENDER_ID=OshudhSathi

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY=your_firebase_server_key

# App
PORT=3001
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Frontend URLs (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://oshudhsathi.com
